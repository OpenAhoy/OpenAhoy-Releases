{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "wechat-ecosystem",
  "version": "0.6.65",
  "description": "OpenAhoy is an account and content workspace for WeChat Official Accounts, X, and Xiaohongshu in Codex.",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "OpenAhoy",
        "shortDescription": "公众号、X 和小红书的账号与内容工作台。",
        "brandColor": "#026364",
        "composerIcon": "./assets/openahoy-v1/openahoy-symbol-color-256.png",
        "logo": "./assets/openahoy-v1/openahoy-symbol-color-256.png",
        "brandColorDark": "#FC5B4A",
        "composerIconDark": "./assets/openahoy-v1/openahoy-symbol-inverse-256.png",
        "logoDark": "./assets/openahoy-v1/openahoy-symbol-inverse-256.png"
      }
    }
  }
}
