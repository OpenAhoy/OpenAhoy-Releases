{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "wechat-ecosystem",
  "version": "0.7.113",
  "description": "Jiusera is a creative workspace in Codex for making content and publishing to WeChat Official Accounts, X, and Xiaohongshu.",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Jiusera",
        "shortDescription": "在 Codex 创作内容、管理账号并发布。",
        "brandColor": "#BE2026",
        "composerIcon": "./assets/jiusera/jiusera-host-light-128.png",
        "logo": "./assets/jiusera/jiusera-host-light-128.png",
        "brandColorDark": "#F2BB23",
        "composerIconDark": "./assets/jiusera/jiusera-host-dark-128.png",
        "logoDark": "./assets/jiusera/jiusera-host-dark-128.png"
      }
    }
  }
}
